<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Enterprise Account Manager</display-name>

    <!-- ============ AES Encryption Key ============ -->
    <context-param>
        <param-name>cryptoKey</param-name>
        <param-value>SbEi/tSuhymi/1Fnk3RWvW4qJGHF7IhewVyiBvcljHI=</param-value>
    </context-param>

    <!-- ============ Filters ============ -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.account.filter.EncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.account.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AdminFilter</filter-name>
        <filter-class>com.account.filter.AdminFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AdminFilter</filter-name>
        <url-pattern>/users</url-pattern>
        <url-pattern>/users/new</url-pattern>
        <url-pattern>/users/create</url-pattern>
        <url-pattern>/users/edit</url-pattern>
        <url-pattern>/users/update</url-pattern>
        <url-pattern>/users/delete</url-pattern>
        <url-pattern>/platforms</url-pattern>
        <url-pattern>/platforms/create</url-pattern>
        <url-pattern>/platforms/delete</url-pattern>
        <url-pattern>/accounts/export</url-pattern>
        <url-pattern>/accounts/import</url-pattern>
        <url-pattern>/accounts/password/history</url-pattern>
        <url-pattern>/groups</url-pattern>
        <url-pattern>/groups/members</url-pattern>
    </filter-mapping>

    <!-- ============ Auth Servlets ============ -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.account.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.account.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>InitServlet</servlet-name>
        <servlet-class>com.account.servlet.InitServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>InitServlet</servlet-name>
        <url-pattern>/init</url-pattern>
    </servlet-mapping>

    <!-- ============ Dashboard ============ -->
    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.account.servlet.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <!-- ============ Account Servlets ============ -->
    <servlet>
        <servlet-name>AccountListServlet</servlet-name>
        <servlet-class>com.account.servlet.AccountListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AccountListServlet</servlet-name>
        <url-pattern>/accounts</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AccountFormServlet</servlet-name>
        <servlet-class>com.account.servlet.AccountFormServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AccountFormServlet</servlet-name>
        <url-pattern>/accounts/new</url-pattern>
        <url-pattern>/accounts/edit</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AccountCreateServlet</servlet-name>
        <servlet-class>com.account.servlet.AccountCreateServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AccountCreateServlet</servlet-name>
        <url-pattern>/accounts/create</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AccountUpdateServlet</servlet-name>
        <servlet-class>com.account.servlet.AccountUpdateServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AccountUpdateServlet</servlet-name>
        <url-pattern>/accounts/update</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AccountDeleteServlet</servlet-name>
        <servlet-class>com.account.servlet.AccountDeleteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AccountDeleteServlet</servlet-name>
        <url-pattern>/accounts/delete</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AccountDetailServlet</servlet-name>
        <servlet-class>com.account.servlet.AccountDetailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AccountDetailServlet</servlet-name>
        <url-pattern>/accounts/detail</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PasswordViewServlet</servlet-name>
        <servlet-class>com.account.servlet.PasswordViewServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PasswordViewServlet</servlet-name>
        <url-pattern>/accounts/password/view</url-pattern>
    </servlet-mapping>

    <!-- ============ User Servlets ============ -->
    <servlet>
        <servlet-name>UserListServlet</servlet-name>
        <servlet-class>com.account.servlet.UserListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserListServlet</servlet-name>
        <url-pattern>/users</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UserFormServlet</servlet-name>
        <servlet-class>com.account.servlet.UserFormServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserFormServlet</servlet-name>
        <url-pattern>/users/new</url-pattern>
        <url-pattern>/users/edit</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UserCreateServlet</servlet-name>
        <servlet-class>com.account.servlet.UserCreateServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserCreateServlet</servlet-name>
        <url-pattern>/users/create</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UserUpdateServlet</servlet-name>
        <servlet-class>com.account.servlet.UserUpdateServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserUpdateServlet</servlet-name>
        <url-pattern>/users/update</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UserDeleteServlet</servlet-name>
        <servlet-class>com.account.servlet.UserDeleteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserDeleteServlet</servlet-name>
        <url-pattern>/users/delete</url-pattern>
    </servlet-mapping>

    <!-- ============ Platform Servlets ============ -->
    <servlet>
        <servlet-name>PlatformListServlet</servlet-name>
        <servlet-class>com.account.servlet.PlatformListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PlatformListServlet</servlet-name>
        <url-pattern>/platforms</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PlatformCreateServlet</servlet-name>
        <servlet-class>com.account.servlet.PlatformCreateServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PlatformCreateServlet</servlet-name>
        <url-pattern>/platforms/create</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PlatformDeleteServlet</servlet-name>
        <servlet-class>com.account.servlet.PlatformDeleteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PlatformDeleteServlet</servlet-name>
        <url-pattern>/platforms/delete</url-pattern>
    </servlet-mapping>

    <!-- ============ Application Servlets ============ -->
    <servlet>
        <servlet-name>AppCreateServlet</servlet-name>
        <servlet-class>com.account.servlet.AppCreateServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AppCreateServlet</servlet-name>
        <url-pattern>/applications/create</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AppMyServlet</servlet-name>
        <servlet-class>com.account.servlet.AppMyServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AppMyServlet</servlet-name>
        <url-pattern>/applications/my</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AppPendingServlet</servlet-name>
        <servlet-class>com.account.servlet.AppPendingServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AppPendingServlet</servlet-name>
        <url-pattern>/applications/pending</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AppReviewServlet</servlet-name>
        <servlet-class>com.account.servlet.AppReviewServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AppReviewServlet</servlet-name>
        <url-pattern>/applications/review</url-pattern>
    </servlet-mapping>

    <!-- ============ Export / Import Servlets ============ -->
    <servlet>
        <servlet-name>AccountExportServlet</servlet-name>
        <servlet-class>com.account.servlet.AccountExportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AccountExportServlet</servlet-name>
        <url-pattern>/accounts/export</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AccountImportServlet</servlet-name>
        <servlet-class>com.account.servlet.AccountImportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AccountImportServlet</servlet-name>
        <url-pattern>/accounts/import</url-pattern>
    </servlet-mapping>

    <!-- ============ Log Servlet ============ -->
    <servlet>
        <servlet-name>LogListServlet</servlet-name>
        <servlet-class>com.account.servlet.LogListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogListServlet</servlet-name>
        <url-pattern>/logs</url-pattern>
    </servlet-mapping>

    <!-- ============ Assign / PasswordHistory Servlets ============ -->
    <servlet>
        <servlet-name>AccountAssignServlet</servlet-name>
        <servlet-class>com.account.servlet.AccountAssignServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AccountAssignServlet</servlet-name>
        <url-pattern>/accounts/assign</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PasswordHistoryServlet</servlet-name>
        <servlet-class>com.account.servlet.PasswordHistoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PasswordHistoryServlet</servlet-name>
        <url-pattern>/accounts/password/history</url-pattern>
    </servlet-mapping>

    <!-- ============ User Group Servlets ============ -->
    <servlet>
        <servlet-name>UserGroupListServlet</servlet-name>
        <servlet-class>com.account.servlet.UserGroupListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserGroupListServlet</servlet-name>
        <url-pattern>/groups</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UserGroupMemberServlet</servlet-name>
        <servlet-class>com.account.servlet.UserGroupMemberServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserGroupMemberServlet</servlet-name>
        <url-pattern>/groups/members</url-pattern>
    </servlet-mapping>

    <!-- ============ Welcome ============ -->
    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>

</web-app>
